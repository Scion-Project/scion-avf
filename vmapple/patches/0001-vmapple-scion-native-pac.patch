diff --git a/osfmk/arm64/pac_asm.h b/osfmk/arm64/pac_asm.h
index d211433..4855ed5 100644
--- a/osfmk/arm64/pac_asm.h
+++ b/osfmk/arm64/pac_asm.h
@@ -43,6 +43,10 @@
 
 #if defined(HAS_APPLE_PAC)
 
+#if SCION_NATIVE_PAC
+/* scion_pac_keys: IA, IB, DA, DB, GA (lo, hi each), then a nonzero "ready" word */
+#define SCION_PAC_KEY_WORDS	10
+#endif /* SCION_NATIVE_PAC */
 
 /* BEGIN IGNORE CODESTYLE */
 
@@ -146,6 +150,60 @@
  *   tmp2 - scratch register
  */
 .macro PAC_INIT_KEY_STATE	tmp, tmp2
+#if SCION_NATIVE_PAC
+	/*
+	 * The first CPU here fills scion_pac_keys from the virtual and physical
+	 * counters (a 64-bit mix per word) and marks it ready; every CPU, the
+	 * first included, then loads the five keys from it. This runs with the
+	 * MMU off, so the block is read and written in memory, not in a cache.
+	 * Clobbers x0-x5 (\tmp and \tmp2 are among them at the only call site).
+	 */
+	adrp	x4, EXT(scion_pac_keys)@page
+	add		x4, x4, EXT(scion_pac_keys)@pageoff
+	ldr		x0, [x4, #(SCION_PAC_KEY_WORDS * 8)]
+	cbnz	x0, 2f
+	mrs		x0, CNTPCT_EL0
+	mrs		x1, CNTVCT_EL0
+	eor		x0, x0, x1, ror #17
+	mov		x5, #0
+1:
+	MOV64	x1, 0x9e3779b97f4a7c15
+	add		x0, x0, x1
+	mov		x2, x0
+	eor		x2, x2, x2, lsr #30
+	MOV64	x1, 0xbf58476d1ce4e5b9
+	mul		x2, x2, x1
+	eor		x2, x2, x2, lsr #27
+	MOV64	x1, 0x94d049bb133111eb
+	mul		x2, x2, x1
+	eor		x2, x2, x2, lsr #31
+	mrs		x1, CNTPCT_EL0
+	eor		x2, x2, x1, lsl #41
+	str		x2, [x4, x5, lsl #3]
+	add		x5, x5, #1
+	cmp		x5, #(SCION_PAC_KEY_WORDS)
+	b.lo	1b
+	mov		x0, #1
+	str		x0, [x4, #(SCION_PAC_KEY_WORDS * 8)]
+	dsb		sy
+2:
+	ldp		x0, x1, [x4, #0]
+	msr		APIAKeyLo_EL1, x0
+	msr		APIAKeyHi_EL1, x1
+	ldp		x0, x1, [x4, #16]
+	msr		APIBKeyLo_EL1, x0
+	msr		APIBKeyHi_EL1, x1
+	ldp		x0, x1, [x4, #32]
+	msr		APDAKeyLo_EL1, x0
+	msr		APDAKeyHi_EL1, x1
+	ldp		x0, x1, [x4, #48]
+	msr		APDBKeyLo_EL1, x0
+	msr		APDBKeyHi_EL1, x1
+	ldp		x0, x1, [x4, #64]
+	msr		APGAKeyLo_EL1, x0
+	msr		APGAKeyHi_EL1, x1
+	isb		sy
+#endif /* SCION_NATIVE_PAC */
 #if HAS_PARAVIRTUALIZED_PAC
 #if HIBERNATION
 	#error PAC_INIT_KEY_STATE is not implemented for HAS_PARAVIRTUALIZED_PAC && HIBERNATION
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 6aa6fe4..47b5d2c 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -876,4 +876,13 @@ arm_init_tramp:
 
 //#include	"globals_asm.h"
 
+#if SCION_NATIVE_PAC
+	/* scion_pac_keys (see PAC_INIT_KEY_STATE): written once, with the MMU off */
+	.section __DATA, __data
+	.align 4
+	.globl EXT(scion_pac_keys)
+LEXT(scion_pac_keys)
+	.space	(SCION_PAC_KEY_WORDS + 1) * 8, 0
+#endif /* SCION_NATIVE_PAC */
+
 /* vim: set ts=4: */
diff --git a/pexpert/pexpert/arm64/VMAPPLE.h b/pexpert/pexpert/arm64/VMAPPLE.h
index 08b3578..511ab23 100644
--- a/pexpert/pexpert/arm64/VMAPPLE.h
+++ b/pexpert/pexpert/arm64/VMAPPLE.h
@@ -37,7 +37,16 @@
 #define APPLEVIRTUALPLATFORM      1
 
 #define CPU_HAS_APPLE_PAC         1
+#if defined(SCION_NATIVE_PAC) && SCION_NATIVE_PAC
+/*
+ * Scion (AVF/crosvm, QEMU virt): there is no Apple hypervisor to take the
+ * VMAPPLE_PAC_* calls, so the kernel programs the architectural ARMv8.3 key
+ * registers itself (see SCION_NATIVE_PAC in arm64/pac_asm.h). The keys are
+ * one set per boot, shared by EL0 and EL1: there are no per-process keys.
+ */
+#else
 #define HAS_PARAVIRTUALIZED_PAC   1
+#endif
 #define HAS_GIC_V3                1
 #define HAS_ARM_FEAT_SSBS2        1
 #define HAS_ARM_FEAT_SME          1
