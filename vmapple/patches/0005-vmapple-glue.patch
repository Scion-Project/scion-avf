+/*
+ * Scion: the pieces of a VMAPPLE kernel that Apple links from the Kernel Debug
+ * Kit's binary archive and the open-source release does not contain, written
+ * for a VM that runs without Apple's hypervisor (crosvm under KVM, QEMU).
+ */
+#include <pexpert/arm64/board_config.h>
+#include <mach/vm_types.h>
+#include <mach/boolean.h>
+#include <kern/ast.h>
+#include <arm/cpu_data_internal.h>
+#include <arm64/amcc_rorgn.h>
+
+/*
+ * Read-only region (KTRR / CTRR / VMAPPLE's paravirtualised CTRR): nothing
+ * locks the kernel's text here; these are the answers of a board without
+ * kernel-integrity hardware.
+ */
+#if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR) || defined(KERNEL_INTEGRITY_PV_CTRR)
+vm_offset_t ctrr_begin, ctrr_end;
+vm_offset_t rorgn_begin, rorgn_end;
+
+void
+rorgn_stash_range(void)
+{
+}
+
+void
+rorgn_lockdown(void)
+{
+}
+
+bool
+rorgn_contains(vm_offset_t addr, vm_size_t size, bool defval)
+{
+#pragma unused(addr, size)
+	return defval;
+}
+
+void
+rorgn_validate_core(void)
+{
+}
+#endif
+
+/* NO_MONITOR: there is no page-table monitor to enable. */
+void ml_enable_monitor(void);
+void
+ml_enable_monitor(void)
+{
+}
+
+/* No fuses on a VM: report a production part, the stricter of the two answers. */
+boolean_t ml_device_is_prod_fused(void);
+boolean_t
+ml_device_is_prod_fused(void)
+{
+	return TRUE;
+}
+
+#if SCHED_HYGIENE_DEBUG && (DEBUG || DEVELOPMENT)
+/* pmap.h's declaration for this configuration; the plain check, as in other configurations. */
+bool pmap_pending_preemption(void);
+bool
+pmap_pending_preemption(void)
+{
+	return !!(*((volatile ast_t *)ast_pending()) & AST_URGENT);
+}
+#endif
+
+/* Clean a range of the data cache to the point of coherency, by VA. */
+static void
+scion_clean_dcache_poc(vm_offset_t va, size_t length)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, CTR_EL0" : "=r"(ctr));
+	const vm_offset_t line = 4UL << ((ctr >> 16) & 0xf);
+	const vm_offset_t end = va + length;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (va &= ~(line - 1); va < end; va += line) {
+		__asm__ volatile ("dc cvac, %0" : : "r"(va) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void CleanPoC_DcacheRegion_Force_nopreempt(vm_offset_t va, size_t length);
+void
+CleanPoC_DcacheRegion_Force_nopreempt(vm_offset_t va, size_t length)
+{
+	scion_clean_dcache_poc(va, length);
+}
+
+void CleanPoC_DcacheRegion_Force_nopreempt_nohid(vm_offset_t va, size_t length);
+void
+CleanPoC_DcacheRegion_Force_nopreempt_nohid(vm_offset_t va, size_t length)
+{
+	scion_clean_dcache_poc(va, length);
+}
